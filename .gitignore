# Public source only. Keep local state and generated artifacts outside Git.
/*
!/.gitignore
!/.prettierignore
!/.prettierrc.json
!/AGENTS.md
!/README.md
!/package.json
!/package-lock.json
!/projects.example.json
!/codex-history.example.json
!/start.command
!/*.mjs
!/*.schema.json
!/lib/
/lib/*
!/lib/*.mjs
!/scripts/
/scripts/*
!/scripts/*.mjs
!/test/
/test/*
!/test/*.mjs
!/test/fixtures/
/test/fixtures/*
!/test/fixtures/desktop-server.cjs
!/public/
/public/*
!/public/*.js
!/public/*.css
!/public/*.html
!/desktop/
/desktop/*
!/desktop/*.cjs
!/desktop/*.plist
!/desktop/config.example.json
!/desktop/assets/
/desktop/assets/*
!/desktop/assets/AgentOffice.icns
!/desktop/assets/trayTemplate.png
!/desktop/assets/trayTemplate@2x.png
!/skills/
/skills/*
!/skills/agent-office/
!/skills/project-setup/
/skills/agent-office/*
/skills/project-setup/*
!/skills/agent-office/SKILL.md
!/skills/project-setup/SKILL.md

# Never publish machine data or a second copy of the reader repository.
/projects.json
/codex-history.json
/desktop/config.json
/services/
**/.data/
**/workspace/
**/outputs/
**/node_modules/
**/dist/
**/dist-desktop/
**/.desktop-build/
**/.cache/
**/.env*
!**/.env.example
**/*.log
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.mobileprovision
**/*.png
**/*.jpg
**/*.jpeg
**/*.webp
**/*.gif
**/*.pdf
**/*.zip
!desktop/assets/trayTemplate.png
!desktop/assets/trayTemplate@2x.png
/public/app.js
/public/styles.css
